# PerpGuard configuration. Copy to .env and fill in as needed.
# Never commit .env. Secrets belong here only, never in source or logs.

# --- Which network each concern uses -----------------------------------------
# Read-only analytics run against mainnet so the demo shows real data.
# All trading actions run against testnet with our own wallet.
ANALYTICS_NETWORK=mainnet
TRADING_NETWORK=testnet
# TWO DEPLOYMENTS (12 Oct 2026): mainnet and testnet each run the backend from
# their own COMPLETE env file (.env for mainnet, .env.testnet for testnet; the
# testnet unit names its file with PERPGUARD_ENV_FILE). Each has its own bot
# token, database and encryption key. What differs between the two files:
#   TRADING_NETWORK, PERPL_NETWORK, PERPGUARD_MAINNET_TRADING (mainnet: 1),
#   TELEGRAM_BOT_TOKEN, DATABASE_URL, PERPGUARD_KEY_ENCRYPTION_KEY,
#   PERPL_API_KEY / PERPL_API_KEY_SECRET / PERPL_ACCOUNT_ID, PUBLIC_WEB_URL,
#   HEALTH_PORT, PERPGUARD_ANALYTICS_JOBS, PEER_BOT_USERNAME, PERPL_BUILDER_ID.
# Set to "off" on the deployment that must NOT run the site's analytics jobs
# (hourly cache warming, treasury scan, open-interest reconcile): the testnet one.
PERPGUARD_ANALYTICS_JOBS=
# The OTHER network's bot, without the @: PerpGuardTestnetBot in the mainnet
# file, PerpGuardBot in the testnet file. Named on Trading account, in /help
# and on /link when a wallet's account is on the other network.
PEER_BOT_USERNAME=
# PERPL BUILDER CODE (docs: api/builder-codes). Bound to every key PerpGuard
# creates through the wallet signature, at enrolment; never to a pasted key.
# The id Perpl issued (1..255). Mainnet only unless Perpl issued one for
# testnet too. NEVER commit the value: it goes in the deployment's env file.
PERPL_BUILDER_ID=
# The fee ceiling a user signs for, per 100k (1 = 0.001%, at most 100).
# 0 = attribution with no fee, which is all PerpGuard can use: a builder fee
# applies only to opening or increasing a position.
PERPL_MAX_BUILDER_FEE_PER_100K=0
# The Origin declared to Perpl on key enrolment. ONLY this deployment's own
# site, and only once Perpl has approved it (https://perpguard.app, mainnet).
# Must equal PUBLIC_WEB_URL's origin or the backend refuses to start. Unset:
# no Origin is sent. Never Perpl's own site.
PERPL_ENROLMENT_ORIGIN=
# WEB (set per Vercel project, not here): NEXT_PUBLIC_TRADING_NETWORK
# (mainnet | testnet; unset is testnet), BACKEND_URL (the project's own
# backend) and ANALYTICS_BACKEND_URL (the mainnet backend, on the testnet
# project, so its analytics pages use the warm cache).

# Never act on price data older than this (ms).
STALE_MS=10000

# --- Network overrides --------------------------------------------------------
# Every value below has a documented default in packages/shared/src/config.ts,
# so the read-only demo runs with none of them set. Anything that signs or sends
# a transaction should load config with { strict: true }, which requires all of
# them to be present.
# Docs: https://docs.perpl.xyz/resources/for-developers/networks-and-configuration.md

PERPL_MAINNET_CHAIN_ID=143
PERPL_MAINNET_REST_URL=https://app.perpl.xyz/api
PERPL_MAINNET_WS_MARKET_DATA_URL=wss://app.perpl.xyz/ws/v1/market-data
PERPL_MAINNET_WS_TRADING_URL=wss://app.perpl.xyz/ws/v1/trading
PERPL_MAINNET_RPC_URL=https://rpc.monad.xyz
PERPL_MAINNET_EXCHANGE=0x34B6552d57a35a1D042CcAe1951BD1C370112a6F
PERPL_MAINNET_COLLATERAL=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
PERPL_MAINNET_COLLATERAL_DECIMALS=6

PERPL_TESTNET_CHAIN_ID=10143
PERPL_TESTNET_REST_URL=https://testnet.perpl.xyz/api
PERPL_TESTNET_WS_MARKET_DATA_URL=wss://testnet.perpl.xyz/ws/v1/market-data
PERPL_TESTNET_WS_TRADING_URL=wss://testnet.perpl.xyz/ws/v1/trading
PERPL_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
PERPL_TESTNET_EXCHANGE=0x1964C32f0bE608E7D29302AFF5E61268E72080cc
PERPL_TESTNET_COLLATERAL=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
PERPL_TESTNET_COLLATERAL_DECIMALS=6

# --- Indexer (Envio HyperIndex) -----------------------------------------------
# HyperSync/HyperRPC access token. Requests without one are rejected with 401.
# Create it at https://envio.dev/app/api-tokens.
# Indexers deployed to Envio Cloud do not need it; local `envio dev` does.
# Docs: https://docs.envio.dev/docs/HyperSync/api-tokens
ENVIO_API_TOKEN=

# Every var interpolated into apps/indexer/config.yaml must carry the ENVIO_
# prefix; Envio Cloud does not expose any others at runtime.
# Defaults live in config.yaml, so the indexer runs with none of these set.
ENVIO_PERPL_EXCHANGE=0x34B6552d57a35a1D042CcAe1951BD1C370112a6F
# Used by the market bootstrap in src/lib/chain.ts, not by HyperSync.
ENVIO_PERPL_HYPERSYNC_URL=https://143.hypersync.xyz
ENVIO_PERPL_RPC_URL=https://rpc.monad.xyz
# ~30 days of Monad at ~0.30s per block. The exchange's first block is
# 54,773,010; widen this to backfill further.
ENVIO_PERPGUARD_START_BLOCK=100000000

# Local Postgres. One database serves the indexer and the backend.
#   sudo -u postgres createuser envio -sP && sudo -u postgres createdb -O envio perpguard_indexer
ENVIO_PG_HOST=127.0.0.1
ENVIO_PG_PORT=5432
ENVIO_PG_USER=envio
ENVIO_PG_PASSWORD=
ENVIO_PG_DATABASE=perpguard_indexer
ENVIO_PG_PUBLIC_SCHEMA=public

# --- Trading credentials (testnet only for now) -------------------------------
# Ed25519 API key used to sign trading requests through the Perpl forwarder.
# Create one at https://testnet.perpl.xyz/apikeys with the `trade` scope.
# API keys can never withdraw or transfer funds; those need a wallet signature.
# The private key is never logged, printed or sent anywhere but the signature.
# Names match the docs' own table:
# https://docs.perpl.xyz/resources/for-developers/api/authentication.md

# Which network the credentials below belong to. Trading actions run on testnet.
PERPL_NETWORK=testnet
# The opaque X-API-Key token from enrollment.
PERPL_API_KEY=
# The ed25519 private key, hex of the 32-byte key.
PERPL_API_KEY_SECRET=
# The on-chain trading account id. REQUIRED for the environment session: the
# account registry keys the session by it and tears it down if the key signs
# in as anything else. `pnpm order:test` signs in and prints it on first run.
PERPL_ACCOUNT_ID=

# ── the backend's own Postgres and the Telegram bot ─────────────────────────
# PerpGuard's own tables (links, sealed keys, watch subscriptions, Rescue
# rules, action_log, feature flags). Separate from the indexer's schema.
DATABASE_URL=

# The bot runs inside the backend. Token from @BotFather. Without it the
# backend runs with no bot.
TELEGRAM_BOT_TOKEN=
# The one Telegram user id that /start links to the environment account
# (PERPL_ACCOUNT_ID). Everyone else links through /link.
TELEGRAM_OWNER_ID=

# ── analytics API and the web app ────────────────────────────────────────────
# The indexer's Postgres, read-only, for /api/analytics/*. Without it the
# backend serves /health only and the web app's figures never load. Usually the
# same database the ENVIO_PG_* values above point at:
#   postgres://<ENVIO_PG_USER>:<ENVIO_PG_PASSWORD>@<ENVIO_PG_HOST>:<ENVIO_PG_PORT>/<ENVIO_PG_DATABASE>
INDEXER_DATABASE_URL=

# Where `apps/web` sends /api/* and /health. Defaults to the backend's HEALTH_PORT.
BACKEND_URL=http://127.0.0.1:8080

# ── the wallet on /link ──────────────────────────────────────────────────────
# Dynamic (connect-only) connects the wallet on /link; nothing else on the site
# has a provider. The environment id is public and inlined into the browser
# bundle at build time (scripts/build-web.sh lifts it from this file). Dynamic
# answers only from the origins listed on its environment. Leave it empty and
# /link offers the API-key path only.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# ── linking (Telegram chat -> Perpl account, proof-based) ───────────────────
# The linking page is /link on the web app; the bot's /link command sends a
# one-time URL there. Where the web app is reachable, for that URL:
PUBLIC_WEB_URL=http://localhost:3000

# Seals API keys that users paste on the linking page, AES-256-GCM, at rest.
# 32 bytes hex: `openssl rand -hex 32`. Without it the key path is off and the
# page says so; wallet proof still links to an account PerpGuard already runs.
#
# ROTATION: changing this invalidates every sealed key. Links survive, their
# sessions do not reopen, the bot tells each linked user to /link again, and
# the next proof overwrites the old blob. There is no re-encryption path on
# purpose: holding the old key long enough to re-seal is exactly what a
# rotation exists to destroy.
PERPGUARD_KEY_ENCRYPTION_KEY=

# How many linked accounts may have a live session at once (each is a socket,
# a position set and a risk loop ticking every second). At the cap a new link
# is refused with a sentence; nobody slows down. Default 20.
MAX_ACCOUNT_SESSIONS=

# Demo mode: lets ANYONE open a read-only session on the account this backend
# monitors. Set to 1 only on the judge-facing deployment of PerpGuard's own
# testnet account. A real trader's deployment leaves it unset.
PERPGUARD_DEMO_ACCOUNT=

# DEV ONLY, and ignored when NODE_ENV=production. The Telegram bot hands the
# linked chat a one-time sign-in code (/web); this flag also lets the operator
# mint one from the backend host itself: `curl http://127.0.0.1:8080/dev/link-code`.
# Loopback only. Leave it unset on anything anyone else can reach.
PERPGUARD_WEB_DEV_LINK=
