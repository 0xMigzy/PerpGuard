# PerpGuard configuration. Copy to .env and fill in as needed.
# Never commit .env. Secrets belong here only, never in source or logs.

# --- Which network each concern uses -----------------------------------------
# Read-only analytics run against mainnet so the demo shows real data.
# All trading actions run against testnet with our own wallet.
ANALYTICS_NETWORK=mainnet
TRADING_NETWORK=testnet

# Never act on price data older than this (ms).
STALE_MS=10000

# --- Network overrides --------------------------------------------------------
# Every value below has a documented default in packages/shared/src/config.ts,
# so the read-only demo runs with none of them set. Anything that signs or sends
# a transaction should load config with { strict: true }, which requires all of
# them to be present.
# Docs: https://docs.perpl.xyz/resources/for-developers/networks-and-configuration.md

PERPL_MAINNET_CHAIN_ID=143
PERPL_MAINNET_REST_URL=https://app.perpl.xyz/api
PERPL_MAINNET_WS_MARKET_DATA_URL=wss://app.perpl.xyz/ws/v1/market-data
PERPL_MAINNET_WS_TRADING_URL=wss://app.perpl.xyz/ws/v1/trading
PERPL_MAINNET_RPC_URL=https://rpc.monad.xyz
PERPL_MAINNET_EXCHANGE=0x34B6552d57a35a1D042CcAe1951BD1C370112a6F
PERPL_MAINNET_COLLATERAL=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
PERPL_MAINNET_COLLATERAL_DECIMALS=6

PERPL_TESTNET_CHAIN_ID=10143
PERPL_TESTNET_REST_URL=https://testnet.perpl.xyz/api
PERPL_TESTNET_WS_MARKET_DATA_URL=wss://testnet.perpl.xyz/ws/v1/market-data
PERPL_TESTNET_WS_TRADING_URL=wss://testnet.perpl.xyz/ws/v1/trading
PERPL_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
PERPL_TESTNET_EXCHANGE=0x1964C32f0bE608E7D29302AFF5E61268E72080cc
PERPL_TESTNET_COLLATERAL=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
PERPL_TESTNET_COLLATERAL_DECIMALS=6

# --- Indexer (Envio HyperIndex) -----------------------------------------------
# HyperSync/HyperRPC access token. Requests without one are rejected with 401.
# Create it at https://envio.dev/app/api-tokens.
# Indexers deployed to Envio Cloud do not need it; local `envio dev` does.
# Docs: https://docs.envio.dev/docs/HyperSync/api-tokens
ENVIO_API_TOKEN=

# --- Trading credentials (testnet only for now) -------------------------------
# Ed25519 API key used to sign trading requests through the Perpl forwarder.
# Create one at https://testnet.perpl.xyz/apikeys with the `trade` scope.
# API keys can never withdraw or transfer funds; those need a wallet signature.
# The private key is never logged, printed or sent anywhere but the signature.
# Names match the docs' own table:
# https://docs.perpl.xyz/resources/for-developers/api/authentication.md

# Which network the credentials below belong to. Trading actions run on testnet.
PERPL_NETWORK=testnet
# The opaque X-API-Key token from enrollment.
PERPL_API_KEY=
# The ed25519 private key, hex of the 32-byte key.
PERPL_API_KEY_SECRET=
# The on-chain trading account id. Leave empty on first run: `pnpm order:test`
# signs in, reads it off the WalletSnapshot and prints it for you to paste here.
PERPL_ACCOUNT_ID=
