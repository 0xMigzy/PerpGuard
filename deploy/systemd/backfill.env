# Loaded AFTER apps/indexer/.env by the unit, so these win over it. The start
# block is the Exchange proxy's first block on Monad mainnet (2026-02-11); the
# shared .env says 100000000, which is what bit the first launch.
ENVIO_HASURA=false
ENVIO_TUI=false
TUI_OFF=true
ENVIO_PG_SCHEMA=perpguard_full
ENVIO_INDEXER_PORT=9899
ENVIO_PERPGUARD_START_BLOCK=54773010
