# Loaded AFTER /root/PerpGuard/.env.testnet by the testnet unit, so these win over it. No secrets here.
NODE_ENV=production
# Loopback only: Caddy (api-testnet.perpguard.app) is the way in.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8081
# The mainnet backend keeps the site's analytics warm; this one must not run those scans a second time.
PERPGUARD_ANALYTICS_JOBS=off
