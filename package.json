{
  "name": "perpguard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail typecheck && tsc --noEmit -p tsconfig.json",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "start": "node --env-file-if-exists=.env apps/backend/src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env apps/backend/src/server.ts",
    "web": "pnpm --filter @perpguard/web dev",
    "markets": "node apps/backend/src/scripts/print-markets.ts",
    "prices": "node --env-file-if-exists=.env apps/backend/src/scripts/watch-prices.ts",
    "order:test": "node --env-file-if-exists=.env scripts/placeTestOrder.ts",
    "positions:probe": "node --env-file-if-exists=.env scripts/probePositions.ts",
    "sn:probe": "node --env-file-if-exists=.env scripts/probeHeartbeatSn.ts",
    "risk:live": "node --env-file-if-exists=.env apps/backend/src/scripts/live-risk-run.ts",
    "actions:live": "node --env-file-if-exists=.env apps/backend/src/scripts/live-action-run.ts",
    "close:probe": "node --env-file-if-exists=.env apps/backend/src/scripts/probe-close.ts",
    "analytics:live": "node --env-file-if-exists=.env apps/backend/src/scripts/analytics-live.ts",
    "probe:opens": "node --env-file-if-exists=.env apps/backend/src/scripts/probe-opens.ts",
    "copy:live-demo": "node --env-file-if-exists=.env apps/backend/src/scripts/copy-live-demo.ts",
    "copy:replay": "node --env-file-if-exists=.env apps/backend/src/scripts/copy-replay-live.ts",
    "watch:demo": "node --env-file-if-exists=.env apps/backend/src/scripts/watch-e2e-demo.ts",
    "bot:account-demo": "node --env-file-if-exists=.env apps/backend/src/scripts/bot-account-demo.ts",
    "bot:map": "node apps/backend/src/scripts/bot-map.ts",
    "bot:screens": "node apps/backend/src/scripts/bot-screens.ts",
    "registry:live": "node --env-file-if-exists=.env apps/backend/src/scripts/registry-live-run.ts",
    "verify:logs": "node --env-file-if-exists=.env apps/indexer/src/scripts/verify-logs.ts",
    "protocol:flows": "node --env-file-if-exists=.env apps/indexer/src/scripts/protocol-flows.ts",
    "exchange:reconcile": "node --env-file-if-exists=.env apps/indexer/src/scripts/exchange-balance-reconcile.ts",
    "probe:connections": "node --env-file-if-exists=.env apps/backend/src/scripts/probe-connection-limit.ts"
  },
  "devDependencies": {
    "@perpguard/shared": "workspace:*",
    "@types/node": "~24.13.6",
    "typescript": "^5.9.0",
    "viem": "^2.56.9"
  }
}
